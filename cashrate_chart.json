{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "autosize": "fit-x",
  "title": {
    "text": "",
    "subtitle": "Drag the mouse over the bottom chart to zoom into specific periods.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/wbin0005-lab/2179/main/data/cashrate_cleaned.csv",
    "format": { "type": "csv" }
  },
  "vconcat": [
    {
      "width": "container",
      "height": 350,
      "layer": [
        {
          "name": "Main Line Chart",
          "mark": {
            "type": "line",
            "color": "#1a6fc4",
            "strokeWidth": 1.8,
            "interpolate": "monotone"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "title": "Date",
              "scale": {"domain": {"param": "brush"}},
              "axis": { "format": "%Y", "tickCount": "year", "labelAngle": -45 }
            },
            "y": {
              "field": "CashRate",
              "type": "quantitative",
              "title": "Cash Rate (%)",
              "scale": { "zero": true, "domain": [-2, 16] },
              "axis": { "format": ".1f", "tickCount": 8 }
            },
            "tooltip": [
              { "field": "Date", "type": "temporal", "format": "%b %Y", "title": "Month" },
              { "field": "CashRate", "type": "quantitative", "format": ".2f", "title": "Cash Rate (%)" }
            ]
          }
        },
        {
          "name": "Annotation Dots",
          "data": {
            "values": [
              { "date": "2008-03-01", "rate": 7.25 },
              { "date": "2020-11-01", "rate": 0.10 },
              { "date": "2023-11-01", "rate": 4.35 }
            ]
          },
          "mark": {
            "type": "circle",
            "size": 75,
            "color": "#d62728",
            "opacity": 1
          },
          "encoding": {
            "x": { 
              "field": "date", 
              "type": "temporal",
              "scale": {"domain": {"param": "brush"}} 
            },
            "y": {
              "field": "rate",
              "type": "quantitative"
            }
          }
        },
        {
          "name": "Annotation Text Labels",
          "data": {
            "values": [
              { "date": "2008-03-01", "rate": 7.25, "label": "GFC Peak (7.25%)" },
              { "date": "2020-11-01", "rate": 0.5, "label": "COVID Low (0.1%)" },
              { "date": "2023-11-01", "rate": 4.35, "label": "Inflation Hikes Peak (4.35%)" }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -10,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#d62728"
          },
          "encoding": {
            "x": { 
              "field": "date", 
              "type": "temporal",
              "scale": {"domain": {"param": "brush"}}
            },
            "y": { "field": "rate", "type": "quantitative" },
            "text": { "field": "label" }
          }
        }
      ]
    },
    {
      "name": "Context Brushing Chart",
      "width": "container",
      "height": 60,
      "mark": {
        "type": "area",
        "color": "#a8cdda",
        "opacity": 0.5
      },
      "params": [
        {
          "name": "brush",
          "select": {"type": "interval", "encodings": ["x"]}
        }
      ],
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "title": null,
          "axis": {"format": "%Y", "tickCount": "year"}
        },
        "y": {
          "field": "CashRate",
          "type": "quantitative",
          "axis": null
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": "transparent" },
    "axis": { "grid": true, "gridColor": "#e8e8e8", "domainColor": "#ccc" },
    "background": "#ffffff"
  }
}