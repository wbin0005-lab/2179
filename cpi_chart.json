{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "",
    "subtitle": "Year-on-year % change — Source: ABS",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/wbin0005-lab/2179/main/data/cpi_cleaned.csv",
    "format": { "type": "csv" }
  },
  "layer": [
    {
      "name": "Zero reference line",
      "mark": {
        "type": "rule",
        "color": "#999999",
        "strokeWidth": 1.5,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "y": { "datum": 0 }
      }
    },
    {
      "name": "RBA target band (2% - 3%)",
      "mark": {
        "type": "rect",
        "opacity": 0.03,
        "color": "#7dc5db"
      },
      "encoding": {
        "y":  { "datum": 2 },
        "y2": { "datum": 3 }
      }
    },
    {
      "name": "RBA Target Band Label",
      "data": {
        "values": [
          { "year": "1974", "y_pos": 2.5, "label": "RBA Target Band (2-3%)" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1a6fc4"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "y_pos", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },
    {
      "name": "Main CPI line",
      "mark": {
        "type": "line",
        "color": "#c0392b",
        "strokeWidth": 2,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": -45,
            "tickCount": 10,
            "labelOverlap": "parity"
          }
        },
        "y": {
          "field": "CPI",
          "type": "quantitative",
          "title": "CPI (%)",
          "axis": { "format": ".1f", "tickCount": 8 }
        }
      }
    },
    {
      "name": "Data point dots (handles tooltips smoothly)",
      "mark": {
        "type": "point",
        "color": "#c0392b",
        "size": 40,
        "filled": true,
        "opacity": 0.9
      },
      "encoding": {
        "x": { "field": "Year", "type": "ordinal" },
        "y": { "field": "CPI",  "type": "quantitative" },
        "tooltip": [
          { "field": "Year", "type": "ordinal",     "title": "Year" },
          { "field": "CPI",  "type": "quantitative", "format": ".2f", "title": "CPI (%)" }
        ]
      }
    },
    {
      "name": "Annotation Vertical Lines",
      "data": {
        "values": [
          { "year": "1974" },
          { "year": "1990" },
          { "year": "2022" }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "#666666",
        "strokeWidth": 1.5,
        "opacity": 0.6
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" }
      }
    },
    {
      "name": "Annotation Text Labels",
      "data": {
        "values": [
          { "year": "1974", "cpi": 16.5, "label": "Oil Shock Peak (15.4%)" },
          { "year": "1990", "cpi": 9.5,  "label": "Recession & Targeting" },
          { "year": "2022", "cpi": 8.0,  "label": "Post-COVID Surge (6.6%)" }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#444444"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "cpi", "type": "quantitative" },
        "text": { "field": "label" },
        "align": {
          "condition": {
            "test": "datum.year == '2022'",
            "value": "right"
          },
          "value": "left"
        },
        "xOffset": {
          "condition": {
            "test": "datum.year == '2022'",
            "value": -6
          },
          "value": 6
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": "transparent" },
    "axis": { "grid": true, "gridColor": "#eeeeee", "domainColor": "#cccccc" },
    "background": "#ffffff"
  }
}