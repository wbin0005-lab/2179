{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia Annual CPI Inflation (1960–2026)",
    "subtitle": "Year-on-year % change — Source: ABS",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 900,
  "height": 420,
  "data": {
    "url": "YOUR_DATA_URL_HERE",
    "format": { "type": "csv" }
  },

  "layer": [

    {
      "_comment": "Zero reference line",
      "mark": {
        "type": "rule",
        "color": "#cccccc",
        "strokeWidth": 1,
        "strokeDash": [3, 3]
      },
      "encoding": {
        "y": { "datum": 0 }
      }
    },

    {
      "_comment": "RBA target band — 2% to 3% shaded zone",
      "mark": {
        "type": "rect",
        "opacity": 0.06,
        "color": "#2ecc71"
      },
      "encoding": {
        "y":  { "datum": 2 },
        "y2": { "datum": 3 }
      }
    },

    {
      "_comment": "Main CPI line",
      "mark": {
        "type": "line",
        "color": "#c0392b",
        "strokeWidth": 2,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": -45,
            "tickCount": 10,
            "labelOverlap": "parity"
          }
        },
        "y": {
          "field": "CPI",
          "type": "quantitative",
          "title": "CPI Change (%)",
          "axis": { "format": ".1f", "tickCount": 8 }
        },
        "tooltip": [
          { "field": "Year",  "type": "ordinal",      "title": "Year" },
          { "field": "CPI",   "type": "quantitative",  "format": ".2f", "title": "CPI (%)" }
        ]
      }
    },

    {
      "_comment": "Data point dots",
      "mark": {
        "type": "point",
        "color": "#c0392b",
        "size": 30,
        "filled": true,
        "opacity": 0.7
      },
      "encoding": {
        "x": { "field": "Year", "type": "ordinal" },
        "y": { "field": "CPI",  "type": "quantitative" },
        "tooltip": [
          { "field": "Year", "type": "ordinal",     "title": "Year" },
          { "field": "CPI",  "type": "quantitative", "format": ".2f", "title": "CPI (%)" }
        ]
      }
    },

    {
      "_comment_annotations_guide": [
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        "HOW TO ADD PERIOD ANNOTATIONS",
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        "",
        "NOTE: Year is ORDINAL (not temporal) in this chart.",
        "Use exact year strings like '1974' for x values.",
        "",
        "OPTION A — Shaded rect band (for a year range)",
        "Add this as a layer with mark: rect. Example:",
        "",
        "  {",
        "    'data': { 'values': [",
        "      { 'start': '1973', 'end': '1983', 'label': 'Great Inflation' }",
        "    ]},",
        "    'mark': { 'type': 'rect', 'opacity': 0.12, 'color': '#e05c5c' },",
        "    'encoding': {",
        "      'x':  { 'field': 'start', 'type': 'ordinal' },",
        "      'x2': { 'field': 'end',   'type': 'ordinal' },",
        "      'color': { 'value': '#e05c5c' }",
        "    }",
        "  }",
        "",
        "OPTION B — Vertical rule line (for a single year)",
        "Add this as a layer with mark: rule. Example:",
        "",
        "  {",
        "    'data': { 'values': [{ 'year': '1990' }] },",
        "    'mark': { 'type': 'rule', 'strokeDash': [4,3], 'color': '#888', 'strokeWidth': 1.5 },",
        "    'encoding': { 'x': { 'field': 'year', 'type': 'ordinal' } }",
        "  }",
        "",
        "OPTION C — Text label on the chart",
        "Add this as a layer with mark: text. Example:",
        "",
        "  {",
        "    'data': { 'values': [",
        "      { 'year': '1974', 'cpi': 15.42, 'label': 'Oil shock peak' }",
        "    ]},",
        "    'mark': { 'type': 'text', 'dy': -12, 'fontSize': 11, 'fontStyle': 'italic' },",
        "    'encoding': {",
        "      'x':    { 'field': 'year', 'type': 'ordinal' },",
        "      'y':    { 'field': 'cpi',  'type': 'quantitative' },",
        "      'text': { 'field': 'label' }",
        "    }",
        "  }",
        "",
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        "SUGGESTED PERIODS TO ANNOTATE (from your data)",
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        "",
        "↑ PEAK   1973–1975  — Oil shock / Great Inflation:  peak 15.42% (1974)",
        "↓ DOWN   1976–1978  — Disinflation begins:          15% → 8%",
        "↑ UP     1979–1983  — Second oil shock / recession: back to 11.35% (1982)",
        "↓ DOWN   1983–1984  — Sharp disinflation:           10% → 3.96%",
        "↑ UP     1985–1990  — Late-80s surge:               back to 9.05% (1986)",
        "↓ DOWN   1990–1993  — Recession & RBA targeting:    7.3% → 1.01%",
        "↑ BUMP   1995       — GST transition spike:         4.63%",
        "↓ LOW    1997–1999  — Near-deflation period:        0.22% (1997)",
        "↑ UP     2000–2001  — GST introduction:             4.46%–4.41%",
        "↓ CALM   2002–2019  — The 'great moderation':       mostly 1–3%",
        "↑ PEAK   2022–2023  — Post-COVID inflation surge:   6.59% (2022)",
        "↓ EASING 2024–2026  — Current easing path:          3.16% → 4.1%"
      ],

      "mark": { "type": "point", "opacity": 0 },
      "encoding": {
        "x": { "field": "Year", "type": "ordinal" },
        "y": { "field": "CPI",  "type": "quantitative" }
      }
    }

  ],

  "config": {
    "view": { "stroke": "transparent" },
    "axis": { "grid": true, "gridColor": "#eeeeee", "domainColor": "#cccccc" },
    "background": "#ffffff"
  }
}
