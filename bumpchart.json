{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Rise of Australian Household Debt (1995–2024)",
    "subtitle": "Global rank based on household debt-to-income ratio among OECD nations.",
    "fontSize": 16,
    "anchor": "start",
    "color": "#111111"
  },
  "width": 700,
  "height": 650,
  "padding": {"left": 130, "right": 130, "top": 20, "bottom": 20},
  "config": {"view": {"stroke": "transparent"}},
  "data": {
    "url": "https://raw.githubusercontent.com/wbin0005-lab/2179/main/data/cleaned_household_debt_bump_chart.csv",
    "format": {"parse": {"Debt_Ratio": "number", "Year": "number"}}
  },
  "transform": [
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "Debt_Ratio", "order": "descending"}],
      "groupby": ["Year"]
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "scale": {"padding": 0.5},
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "grid": true,
        "domain": false,
        "ticks": false,
        "offset": 10
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {"sort": "descending", "domain": [32, 1]},
      "axis": null
    }
  },
  "layer": [
    {
      "name": "Background Lines (Other Countries)",
      "transform": [{"filter": "datum.Country != 'Australia'"}],
      "mark": {"type": "line", "strokeWidth": 1.5, "interpolate": "monotone"},
      "encoding": {
        "color": {"value": "#e2e8f0"},
        "detail": {"field": "Country"}
      }
    },
    {
      "name": "Background Points (All Other Countries)",
      "transform": [{"filter": "datum.Country != 'Australia'"}],
      "mark": {"type": "circle", "size": 50, "opacity": 0.7, "filled": true},
      "encoding": {
        "color": {"value": "#cbd5e1"},
        "detail": {"field": "Country"},
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {
            "field": "Debt_Ratio",
            "type": "quantitative",
            "title": "Debt-to-Income (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "name": "Highlighted Line (Australia)",
      "transform": [{"filter": "datum.Country == 'Australia'"}],
      "mark": {
        "type": "line",
        "strokeWidth": 4.5,
        "color": "#d62728",
        "interpolate": "monotone"
      }
    },
    {
      "name": "Highlighted Points (Australia)",
      "transform": [{"filter": "datum.Country == 'Australia'"}],
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#d62728",
        "filled": true
      },
      "encoding": {
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {
            "field": "Debt_Ratio",
            "type": "quantitative",
            "title": "Debt-to-Income (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "name": "Left Text Labels (All Countries in 1995)",
      "transform": [{"filter": "datum.Year == 1995"}],
      "mark": {"type": "text", "align": "right", "dx": -12, "fontSize": 10},
      "encoding": {
        "text": {"field": "Country"},
        "color": {
          "condition": {
            "test": "datum.Country == 'Australia'",
            "value": "#d62728"
          },
          "value": "#64748b"
        },
        "fontWeight": {
          "condition": {
            "test": "datum.Country == 'Australia'",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    },
    {
      "name": "Right Text Labels (All Countries in 2024)",
      "transform": [{"filter": "datum.Year == 2024"}],
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 10},
      "encoding": {
        "text": {"field": "Country"},
        "color": {
          "condition": {
            "test": "datum.Country == 'Australia'",
            "value": "#d62728"
          },
          "value": "#64748b"
        },
        "fontWeight": {
          "condition": {
            "test": "datum.Country == 'Australia'",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    }
  ]
}